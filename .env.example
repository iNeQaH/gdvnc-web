# DATABASE (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth (required in production; local may omit and use a dev fallback)
JWT_SECRET="replace-with-a-long-random-string"

# Image uploads (leave empty to skip avatars/covers/works/timeline uploads)
# UPLOADTHING_TOKEN=""

# Cron (required for Vercel cron; Authorization: Bearer CRON_SECRET)
CRON_SECRET="replace-with-a-long-random-string"

# Super Admin (comma-separated). Default username iNeQaH if unset.
# SUPER_ADMIN_USERNAMES="iNeQaH"
# SUPER_ADMIN_USER_IDS=""

# Mail / OTP (registration email fails until these are set)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# Captcha (omit to use the built-in captcha)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
# CAPTCHA_SECRET=""

# Extra email domains allowed at registration (comma-separated)
# EMAIL_DOMAIN_WHITELIST=""
